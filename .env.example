# App
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Postgres (docker-compose builds DATABASE_URL from POSTGRES_PASSWORD; for
# local dev without Docker, set DATABASE_URL directly)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bounce:change-me@localhost:5432/bounce

# Redis — optional locally; matchmaking runs in-memory in one process
# either way (see docs/FSD.md §2). Leave unset for local dev if you don't
# want to run Redis.
REDIS_URL=redis://localhost:6379

# Session / security
SESSION_SECRET=replace-with-a-long-random-string
IP_HASH_SALT=replace-with-a-long-random-string
ADMIN_TOKEN=replace-with-a-long-random-string

# Optional accounts (NextAuth) — leave unset and guest mode is unaffected;
# Google/Email providers are only enabled when their vars are present.
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=Bounce <noreply@bounce.example.com>

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# WebRTC ICE servers (TURN is the coturn service in docker-compose)
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URL=turn:bounce.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=bounce
NEXT_PUBLIC_TURN_CREDENTIAL=change-me

# Backups (scripts/backup-db.sh, docs/BACKUPS.md) — all optional locally;
# BACKUP_GPG_PASSPHRASE and BACKUP_RCLONE_REMOTE are required for a real
# production backup (unencrypted/local-only otherwise).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_PASSPHRASE=
BACKUP_RCLONE_REMOTE=
